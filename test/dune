(executable
 (name test_main)
 (modules test_main)
 (preprocess
  (pps ppx_here))
 (libraries
  alcotest
  alcotest-lwt
  gcloud_tests
  logs.fmt
  mirage-crypto-rng.unix))

(library
 (name gcloud_tests)
 (preprocess
  (pps ppx_here))
 (modules
  (:standard \ test_main))
 (libraries
  alcotest
  alcotest-lwt
  cohttp
  gcloud
  gcloud-lwt
  gcloud-direct
  uri
  yojson))

(rule
 (alias runtest)
 (action
  (run ./test_main.exe)))

; Everything in this directory is local (no external state), so
; [@local-tests] is a view of the directory's [runtest].

(alias
 (name local-tests)
 (deps
  (alias runtest)))
